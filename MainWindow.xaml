<Window x:Class="EnvironmentVariablesEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:EnvironmentVariablesEditor.Localization"
        Title="{x:Static localization:Strings.WindowTitle}"
        Width="980" Height="520" MinWidth="720" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#353535" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Border Background="#EEFFC0" CornerRadius="18" Padding="10">
        <Border Background="#FAFAFA" CornerRadius="22" Padding="24,14,24,18">
            <Border.Effect>
                <DropShadowEffect Color="#75931D" BlurRadius="20" Opacity="0.16" ShadowDepth="2" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="58" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               Text="{x:Static localization:Strings.WindowTitle}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowButtonStyle}" Content="{x:Static localization:Strings.MinimizeButton}"
                                Click="MinimizeButton_OnClick" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="{x:Static localization:Strings.CloseButton}" FontSize="28"
                                Click="CloseButton_OnClick" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" BorderBrush="#525252" BorderThickness="1.5" CornerRadius="18"
                        Background="White" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Variables}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#9A9A9A" VerticalGridLinesBrush="#9A9A9A"
                              BorderThickness="0" Background="White" RowBackground="White"
                              AlternatingRowBackground="#F7FAEF" RowHeight="42" ColumnHeaderHeight="34"
                              SelectionUnit="Cell" SelectionMode="Single"
                              EnableRowVirtualization="True">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#333333" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderBrush" Value="#8A8A8A" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="9,5" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="#FFFFF2" />
                                <Setter Property="Padding" Value="5" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static localization:Strings.ColumnField}" Binding="{Binding Name}" IsReadOnly="True" Width="1.05*" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.ColumnValue}" Width="1.35*">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Value" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{x:Static localization:Strings.ColumnComment}" Binding="{Binding Comment}" IsReadOnly="True" Width="1.25*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="2">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               Foreground="#6B6B6B" FontSize="13" />
                    <Button Content="{x:Static localization:Strings.SaveButton}" Command="{Binding SaveCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            MinWidth="132" Height="38" Padding="20,0" FontWeight="SemiBold"
                            Background="{StaticResource AccentBrush}" Foreground="#26320B"
                            BorderBrush="#9DBB3E" BorderThickness="1" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Border>

</Window>
